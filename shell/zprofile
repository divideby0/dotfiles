# zprofile - loaded for login shells only (before zshrc)
# This is where Homebrew and other system-wide PATH setup belongs

# Homebrew (Apple Silicon, Intel, or Linuxbrew - whichever is installed)
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    [[ -x "$_brew" ]] && { eval "$("$_brew" shellenv)"; break; }
done
unset _brew
